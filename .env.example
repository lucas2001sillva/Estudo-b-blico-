# Local development uses var/vereda.sqlite when DATABASE_URL is empty.
PORT=3001
# DATABASE_URL=libsql://the-host-of-your-created-database
# DATABASE_AUTH_TOKEN=
DATABASE_REQUEST_TIMEOUT_MS=10000

# Render: set these in the service dashboard; never commit the real token.
# DATABASE_AUTH_TOKEN is obtained from that database's settings.
# REQUIRE_REMOTE_DATABASE=1
# SECURE_COOKIES=1
# TRUST_PROXY=1
# PUBLIC_ORIGIN is optional when the public Host is preserved by the proxy.
